{
  "name": "local-stream-server",
  "version": "1.6.0",
  "description": "Enterprise-grade self-hosted streaming server: RTMP ingest, HLS/WebSocket/WebRTC playback, API key auth, recording, real-time stats. Test OBS, vMix, Wirecast locally.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:go": "node server.js & cd go-media-server && ./go-media-server",
    "dev": "nodemon server.js",
    "go:build": "cd go-media-server && go mod tidy && go build -o go-media-server.exe .",
    "go:run": "cd go-media-server && go run .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:go": "cd go-media-server && go test ./... -race -count=1",
    "test:go:bench": "cd go-media-server && go test -bench=. -benchmem ./pkg/stream/",
    "test:all": "npm test && npm run test:go"
  },
  "overrides": {
    "braces": "^3.0.3"
  },
  "keywords": [
    "rtmp",
    "rtmp-server",
    "streaming",
    "live-streaming",
    "obs",
    "obs-studio",
    "encoder",
    "encoder-testing",
    "youtube-live",
    "twitch",
    "vmix",
    "wirecast",
    "hls",
    "ffmpeg",
    "stream-testing",
    "broadcast",
    "self-hosted",
    "nodejs",
    "cloudflare-tunnel"
  ],
  "author": "AMG555",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AMG555/local-stream-server.git"
  },
  "bugs": {
    "url": "https://github.com/AMG555/local-stream-server/issues"
  },
  "homepage": "https://github.com/AMG555/local-stream-server#readme",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "node-media-server": "^2.6.2",
    "socket.io": "^4.6.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "vitest": {
    "include": ["tests/**/*.test.js"],
    "environment": "node",
    "testTimeout": 10000
  }
}
